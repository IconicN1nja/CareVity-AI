# CareVity AI – Backend Environment Variables
# Copy this file to .env and fill in your values.

# Server
PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://carevity:carevity@localhost:5432/carevity
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Sarvam AI (used by the Voice AI Health Coach feature)
# Leave blank to run in offline/fallback mode.
SARVAM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SARVAM_MODEL=sarvam-105b

# Cognito JWT verification (required outside tests/local mock mode)
COGNITO_USER_POOL_ID=eu-north-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Default timezone for date calculations (IANA tz string)
DEFAULT_TIMEZONE=Asia/Kolkata
