{
  "name": "carevity-backend",
  "version": "1.0.0",
  "description": "CareVity AI MVP – Unified single-file Express backend",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "dev:once": "tsx src/server.ts",
    "test": "NODE_ENV=test tsx src/server.test.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "aws-amplify": "^6.22.0",
    "aws-jwt-verify": "^5.2.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.25.1",
    "@aws-amplify/backend-cli": "^1.10.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "aws-cdk-lib": "^2.268.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "private": true
