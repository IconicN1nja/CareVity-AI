{
  "name": "carevity",
  "version": "1.0.0",
  "description": "carevity AI",
  "type": "module",
  "main": "src/index.js",
  "license": "(ISC)",
  "scripts": {
    "dev": "node src/index.js --watch",
    "start": "node src/index.js",
    "build:css": "tailwindcss -i ./src/input.css -o ./public/output.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./public/output.css --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run build:css && npm run format"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^3.4.19"
  },
  "dependencies": {
    "express": "^5.2.1"
  }
}
