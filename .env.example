# CareVity AI - Frontend Environment Configuration Template
# Copy this file to .env and fill in your actual AWS/OpenAI values before deploying.

# The Express backend base URL, without /askAI or /api/v1
EXPO_PUBLIC_API_URL=http://192.168.1.10:4000
# Legacy compatibility: the client also accepts a URL ending in /askAI
EXPO_PUBLIC_AWS_API_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com/prod/askAI

# AWS Cognito Configuration (generated after 'amplify add auth' and 'amplify push')
EXPO_PUBLIC_AWS_REGION=us-east-1
EXPO_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
EXPO_PUBLIC_COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Sarvam credentials belong only on the backend; never put them in this file.
